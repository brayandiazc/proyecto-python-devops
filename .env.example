# ==============================================================================
# Variables de entorno — Proyecto Python DevOps
# ==============================================================================
# Copia este archivo a `.env` y completa los valores para tu entorno.
#   cp .env.example .env
#
# NUNCA subas tu archivo `.env` con valores reales al repositorio.
# Ver SECURITY.md y docs/conventions/secrets.md.
# ==============================================================================

# ── Aplicación ────────────────────────────────────────────────────────────
# Puerto en el que escucha la aplicación Flask (por defecto 5000)
PORT=5000

# ── Despliegue a EC2 (referencia) ─────────────────────────────────────────
# Estos valores NO se usan en local: se configuran como GitHub Actions Secrets
# en Settings > Secrets and variables > Actions. Se listan aquí solo como
# documentación de qué necesita el pipeline de despliegue (.github/workflows/deploy.yml).
#
#   EC2_HOST        IP pública de la instancia EC2 (output de Terraform)
#   EC2_USER        Usuario SSH de la instancia (p. ej. ubuntu)
#   EC2_KEY_BASE64  Clave privada SSH codificada en base64: base64 -i ~/.ssh/id_rsa

# ── Terraform (variables de infraestructura) ──────────────────────────────
# Se definen en terraform/variables.tf o vía TF_VAR_*; NO commitees valores reales.
#   TF_VAR_public_key_path  Ruta a tu clave pública SSH (p. ej. ~/.ssh/id_rsa.pub)
#   TF_VAR_my_ip            Tu IP pública en formato CIDR (p. ej. 181.55.32.88/32)
